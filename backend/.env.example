# ---------------------------------------------------------------------------
# API PNDA S&E (backend/) — variables serveur.
# Copier en .env (ou .env.local) et renseigner. Ne jamais committer le .env.
# ---------------------------------------------------------------------------

PORT=3001
NODE_ENV=development

# ---------------------------------------------------------------------------
# Base de données — Supabase (Postgres géré).
# Trouver ces valeurs dans le dashboard Supabase : Project Settings > Database
# > Connection string (utiliser le mode "Session pooler" ou "Transaction
# pooler" en production ; la connexion directe convient en développement).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@db.VOTRE_PROJET.supabase.co:5432/postgres
DATABASE_SSL=true

# Optionnel : nécessaire seulement si le backend utilise le SDK @supabase/supabase-js
# (auth, storage, realtime) en plus de la connexion Postgres directe.
# Project Settings > API.
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
